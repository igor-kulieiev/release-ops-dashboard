{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    // Respect .gitignore so build output (dist/, test-results/) is never scanned.
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    // mockServiceWorker.js is generated by `msw init` — never hand-edit or reformat it.
    "files": {
        "includes": [
            "**",
            "!dist",
            "!test-results",
            "!public/mockServiceWorker.js"
        ]
    },
    "formatter": {
        "enabled": true,
        // indentStyle/indentWidth/lineWidth deliberately omitted: they come from the
        // repo-root .editorconfig (tabs, width 4, max_line_length 140), which stays the
        // single source of truth. Anything set here would override it.
        "useEditorconfig": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": { "noDefaultExport": "error" }
        }
    },
    // vite.config.ts must use `export default defineConfig(...)` per Vite's own convention.
    "overrides": [
        {
            "includes": ["vite.config.ts"],
            "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
        }
    ],
    // Tailwind v4's @source/@apply/@theme and the `source(none)` import modifier aren't standard
    // CSS — without this, Biome's CSS parser treats every styles/*.css file as unparseable.
    "css": { "parser": { "tailwindDirectives": true } },
    "javascript": {
        "formatter": {
            "semicolons": "always",
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    }
}
