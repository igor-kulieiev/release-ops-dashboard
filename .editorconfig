root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140
trim_trailing_whitespace = true

# Formatted by Biome, which reads this file (biome.jsonc sets useEditorconfig) — so indent
# style/width and line width live here, not duplicated in biome.jsonc.
[*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}]
indent_style = tab
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[{*.markdown,*.md}]
tab_width = 4

[*.json]
indent_style = tab
indent_size = 2
